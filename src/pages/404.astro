---
import Base from '../layouts/Base.astro';
import { Header } from '../components/Header';
import { LightField } from '../components/LightField';
import { Diagram } from '../components/diagram/Diagram';
import { notFoundPath } from '../components/diagram/notFoundPath';
import { site } from '../data/site';

// CloudFront serves this file for any missing path, at that path, so every link
// and asset here must be root-absolute.
const NOT_FOUND_DIAGRAM_MIN_SCALE = 0.6;
---

<Base title={`Page not found — ${site.name}`} description="This page does not exist." noindex>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page">
    <LightField variant="top" />
    <Header base="/" />
    <main id="main" tabindex="-1">
      <section class="notfound wrap" aria-labelledby="notfound-title">
        <div class="notfound-panel glass-panel">
          <div>
            <p class="notfound-kicker">404</p>
            <h1 id="notfound-title" class="enter">This page isn't here.</h1>
            <p class="notfound-lede enter d1">
              The link may be old or mistyped. The work, the projects and the résumé are all one click away.
            </p>
            <div class="actions enter d2">
              <a class="btn btn-primary" href="/">Go to the home page</a>
              <a class="btn btn-glass" href="/resume/">Read the résumé</a>
            </div>
          </div>
          <figure class="notfound-figure">
            <Diagram data={notFoundPath} minScale={NOT_FOUND_DIAGRAM_MIN_SCALE} />
            <figcaption>What happened to your request.</figcaption>
          </figure>
        </div>
      </section>
    </main>
    <footer class="site-footer wrap">
      <span>© {site.fullName}</span>
      <span>{site.location}</span>
      <a href="/">Home</a>
    </footer>
  </div>
</Base>

<script>
  import { initScrollableHosts } from '../scripts/scrollable-hosts';
  import { initDiagramReveal } from '../scripts/diagram-reveal';

  initScrollableHosts();
  initDiagramReveal();
</script>
